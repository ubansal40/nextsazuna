# Copy to .env.local and fill in. NEVER commit .env or .env.local.
#
# Hostinger MySQL — the credentials live in hPanel → Databases.
# Use the hostname, not the IP, so a server move does not break the app.
DB_HOST=srv2226.hstgr.io
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Shared hosting caps concurrent connections. Keep this low; a Next.js app
# opens a pool per server instance, and exhausting the cap takes the site down.
DB_CONNECTION_LIMIT=5

# Payments
# Each gateway's mode comes from the payment_methods content block, which is
# the founder's setting. This variable can only force TEST — it exists so a
# development machine never puts a real transaction through a live gateway.
# Leave it unset in production.
# SAZUNA_PAYMENTS_MODE=test
# Absolute origin used to build gateway return URLs.
SAZUNA_SITE_URL=https://next.sazunajewellers.com
# Credentials. These override the payment_methods content block, which is where
# they live today — move them here before launch (see docs/adr).
# SAZUNA_ESEWA_MERCHANT_CODE=
# SAZUNA_ESEWA_SECRET_KEY=
# SAZUNA_CYBERSOURCE_PROFILE_ID=
# SAZUNA_CYBERSOURCE_ACCESS_KEY=
# SAZUNA_CYBERSOURCE_SECRET_KEY=

# Product images — the sharp pipeline (crop 1000x1000, logo + SKU stamp, AVIF).
# In production point this at the Hostinger sazuna-storage dir and add a
# LiteSpeed alias serving /uploads/* from it; unset, it defaults under public/.
PRODUCT_IMAGE_UPLOAD_DIR=
# Optional: a .ttf/.otf for the SKU stamp. Unset uses the system monospace.
PRODUCT_IMAGE_SKU_FONT_PATH=
# Optional: override the logo composited onto product photos.
PRODUCT_IMAGE_LOGO_PATH=

# Image queue. Photos are processed by a job queue, not by the save request.
# With no daemon in `output: standalone`, the queue is drained by whoever gets
# there first: the save itself (via after()), the products screen while it shows
# a processing row, and — for jobs stranded by a deploy when nobody is looking —
# a cron hitting POST /admin/products/image-jobs.
#
# A cron has no admin session, so set this to a long random string and send it as
# `Authorization: Bearer <token>`. Unset means no token path exists at all;
# anything under 16 characters is ignored rather than trusted.
#   */5 * * * * curl -fsS -X POST -H "Authorization: Bearer $TOKEN" \
#       https://next.sazunajewellers.com/admin/products/image-jobs >/dev/null
# IMAGE_JOB_DRAIN_TOKEN=
#
# Tuning — every one has a working default; set only to change behaviour.
# How long a job may sit in `processing` before it is assumed dead and made
# claimable again. The number that decides how fast a deploy-interrupted job
# recovers (default 360).
# IMAGE_JOB_STALE_SECONDS=360
# Refuse a save once this many jobs are pending or processing (default 500).
# IMAGE_JOB_MAX_BACKLOG=500
# How many jobs one drain takes, and how long it may spend, before handing back
# control to the request it is running inside (defaults 4 and 45000ms).
# IMAGE_JOB_DRAIN_MAX_JOBS=4
# IMAGE_JOB_DRAIN_BUDGET_MS=45000
# Photos encoded at once within one job. A memory dial, not a speed dial — each
# one holds a decoded full-size bitmap (default 2).
# PRODUCT_IMAGE_PROCESS_CONCURRENCY=2
