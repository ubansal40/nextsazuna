# Copy to .env.local and fill in. NEVER commit .env or .env.local.
#
# Hostinger MySQL — the credentials live in hPanel → Databases.
# Use the hostname, not the IP, so a server move does not break the app.
DB_HOST=srv2226.hstgr.io
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Shared hosting caps concurrent connections. Keep this low; a Next.js app
# opens a pool per server instance, and exhausting the cap takes the site down.
DB_CONNECTION_LIMIT=5

# Payments
# Each gateway's mode comes from the payment_methods content block, which is
# the founder's setting. This variable can only force TEST — it exists so a
# development machine never puts a real transaction through a live gateway.
# Leave it unset in production.
# SAZUNA_PAYMENTS_MODE=test
# Absolute origin used to build gateway return URLs.
SAZUNA_SITE_URL=https://next.sazunajewellers.com
# Credentials. These override the payment_methods content block, which is where
# they live today — move them here before launch (see docs/adr).
# SAZUNA_ESEWA_MERCHANT_CODE=
# SAZUNA_ESEWA_SECRET_KEY=
# SAZUNA_CYBERSOURCE_PROFILE_ID=
# SAZUNA_CYBERSOURCE_ACCESS_KEY=
# SAZUNA_CYBERSOURCE_SECRET_KEY=

# Product images — the sharp pipeline (crop 1000x1000, logo + SKU stamp, AVIF).
# Photos are processed inside their own upload request, one per file; there is
# no queue, no worker and nothing to schedule.
#
# In production this MUST point outside the app directory. Hostinger deploys to
# hbuilds/versions/<uuid> and repoints `current` at it, so anything written
# inside the app is destroyed on the next deploy:
#   PRODUCT_IMAGE_UPLOAD_DIR=/home/u721828376/domains/sazuna-storage/uploads/products
# Unset, it defaults under public/ so `next dev` serves the files itself.
# The app serves /uploads/* from this directory either way, so a LiteSpeed alias
# is an optimisation, not a requirement.
PRODUCT_IMAGE_UPLOAD_DIR=
# Optional: a .ttf/.otf for the SKU stamp. Unset uses the system monospace —
# which differs between a Mac and the server, so pin it here if the stamp must
# be glyph-identical everywhere. A stamp that fails to render is a hard error,
# never a silently unstamped photo.
PRODUCT_IMAGE_SKU_FONT_PATH=
# Optional: override the logo composited onto product photos.
PRODUCT_IMAGE_LOGO_PATH=
# Optional: taxonomy artwork. Defaults to a sibling of the product directory, so
# setting PRODUCT_IMAGE_UPLOAD_DIR moves both.
# TAXONOMY_IMAGE_UPLOAD_DIR=

# How many photos are encoded at once, process-wide. A memory dial, not a speed
# dial: each pipeline holds a decoded full-size bitmap (~48 MB for a 4032×3024
# phone photo), and on shared hosting an OOM kill takes the storefront down with
# the admin. Requests past the limit wait for a slot (default 2).
# PRODUCT_IMAGE_PROCESS_CONCURRENCY=2
# How long an upload may wait for a slot before answering 503 (default 30000ms).
# PRODUCT_IMAGE_GATE_WAIT_MS=30000
